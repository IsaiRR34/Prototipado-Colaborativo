  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5fa5a7209f5acd459ff44beb190ae11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LG_DialogueTrigger
  dialogueLines:
  - "\"\xA1Hola! No te hab\xEDa visto antes, debes ser nuevo por aqu\xED.\""
  - "\"\xBFLa compuerta del sector 2? Usualmente est\xE1 cerrada por seguridad.\""
  - "\"Los guardias de la zona tienen la Llave Roja. Uno de ellos est\xE1 patrullando
    cerca de los contenedores.\""
  - "\"Antes de seguir... \xBFPara qu\xE9 quieres ir a esa otra zona?\""
  truthAnswer: "\"Tengo entendido que hay un ser malvado por aqu\xED, necesito eliminarlo.\""
  lieAnswer: "\"Estoy buscando a un viejo amigo y no lo encontr\xE9 en esta zona.\""
