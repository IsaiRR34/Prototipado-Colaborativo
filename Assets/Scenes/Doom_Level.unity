--- !u!114 &621270805
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 621270803}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5fa5a7209f5acd459ff44beb190ae11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LG_DialogueTrigger
  dialogueLines:
  - "\"Esa puerta te llevar\xE1 directo al 'Beb\xE9 Maldito'.\""
  - "\"Usa los pilares de piedra de la arena para esquivar sus embestidas. Cuando
    choque, quedar\xE1 aturdido.\""
  - "\"Dispararle a la cabeza detendr\xE1 sus rituales... si tienes buena punter\xEDa.\""
  - "\"M\xEDrame a los ojos... \xBFCrees que tienes alguna oportunidad de salir vivo?\""
  truthAnswer: "\"Tengo miedo, pero no me rendir\xE9 sin pelear.\""
  lieAnswer: '"Por supuesto, soy invencible. No hay nada que pueda matarme."'
