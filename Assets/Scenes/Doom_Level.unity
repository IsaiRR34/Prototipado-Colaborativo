--- !u!114 &2073263089
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2073263087}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5fa5a7209f5acd459ff44beb190ae11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LG_DialogueTrigger
  dialogueLines:
  - "\"Ese guardia del que te hablaron... ya no es humano. Se transform\xF3 esta
    ma\xF1ana.\""
  - '"Tratamos de quitarle la Llave Roja, pero su piel es dura como la piedra."'
  - "\"Ten cuidado con lo que dices por aqu\xED. Este lugar castiga a los mentirosos,
    la neblina te drena la vida si no eres honesto.\""
  - "\"\xBFT\xFA... sientes alguna conexi\xF3n con esa cosa que llora en el altar
    con el ritual?\""
  truthAnswer: '"No, solo quiero encontrar una salida de este infierno."'
  lieAnswer: "\"S\xED, es mi beb\xE9. Vengo a rescatarlo.\""
