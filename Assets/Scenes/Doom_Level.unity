  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c5fa5a7209f5acd459ff44beb190ae11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LG_DialogueTrigger
  dialogueLines:
  - "\"\xA1Sobreviviste a las afueras! Cre\xED que eras uno de ellos.\""
  - "\"El casco urbano est\xE1 plagado y demasiado oscuro. Enciende tu linterna con
    el n\xFAmero 2.\""
  - "\"Necesitas la Llave Azul para abrir la compuerta del altar ritual. El infectado
    m\xE1s grande de esta \xE1rea se la trag\xF3.\""
  - "\"\xBFTienes suficiente munici\xF3n para enfrentarlo?\""
  truthAnswer: "\"Tengo lo necesario, pero tendr\xE9 que apuntar a la cabeza para
    ahorrar balas.\""
  lieAnswer: '"Voy sobrado, tengo un arsenal entero en los bolsillos."'
